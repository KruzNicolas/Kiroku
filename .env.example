# Notion
NOTION_TOKEN=secret_your_notion_token_here
NOTION_DATABASE_ID_VIDEOS=your_videos_database_id_here
NOTION_DATABASE_ID_STUDY_ASSETS_JAPANESE=

# AI (OpenCode Go subscription — OpenAI-compatible endpoint)
# Set AI_API_KEY to your OpenCode Go API key
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_API_KEY=your_opencode_go_api_key_here
AI_MODEL_VIDEO=mimo-v2.5
AI_MODEL_RECEIPTS=mimo-v2.5-pro

# Per-module overrides (optional — fall back to AI_* globals above when unset)
# VIDEOS_AI_BASE_URL=https://opencode.ai/zen/go/v1
# RECEIPTS_AI_BASE_URL=https://opencode.ai/zen/go/v1

# Receipts
RECEIPTS_GOOGLE_SHEETS_URL=
RECEIPTS_GOOGLE_SHEETS_API_TOKEN=replace_with_post_api_token

VIDEOS_ADDED_AT_TIMEZONE=America/Bogota
INTERNAL_API_TOKEN=replace_with_strong_token
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_VIDEOS_PER_MIN=20
RATE_LIMIT_VIDEOS_BATCH_PER_MIN=10
RATE_LIMIT_RECEIPTS_PER_MIN=5
RATE_LIMIT_STUDY_ASSETS_JP_PER_MIN=15
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
APP_TEST_WRITE_MODE=false
